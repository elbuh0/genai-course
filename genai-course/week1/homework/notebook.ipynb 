        "import torch.nn as nn\n",
        "\n",
        "class VAE(nn.Module):\n",
        "    def __init__(self, latent_dim=16):\n",
        "        super().__init__()\n",
        "        # Encoder: image -> mu, log_var\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Flatten(), # Flattens image 28x28 image into 1D vector\n",
        "            nn.Linear(784, 256), nn.ReLU(), # Compresses to 256\n",
        "            nn.Linear(256, 64),  nn.ReLU(), # Further compresses to 64\n",
        "        )\n",
        "        self.fc_mu  = nn.Linear(64, latent_dim)\n",
        "        self.fc_var = nn.Linear(64, latent_dim)\n",
        "        # Decoder: z -> image\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(latent_dim, 64),  nn.ReLU(), # Adds nonlinearity\n",
        "            nn.Linear(64, 256),         nn.ReLU(), # Expands to 256\n",
        "            nn.Linear(256, 784),        nn.Sigmoid(), # Expands to 784; constrains output to [0,1]\n",
        "            nn.Unflatten(1, (1, 28, 28)) # Expands to 28x28 image\n",
        "        )\n",
        "\n",
        "    def reparameterise(self, mu, log_var): # Implements the reparametization trick, using randomness to sample z while allowing back-propagation\n",
        "        std = torch.exp(0.5 * log_var)\n",
        "        eps = torch.randn_like(std)\n",
        "        return mu + eps * std\n",
        "\n",
        "    def forward(self, x): # Defines VAE architecture\n",
        "        h    = self.encoder(x)\n",
        "        mu   = self.fc_mu(h)\n",
        "        lv   = self.fc_var(h)\n",
        "        z    = self.reparameterise(mu, lv)\n",
        "        recon = self.decoder(z)\n",
        "        return recon, mu, lv\n",
        "\n",
        "def vae_loss(recon, x, mu, lv): # Implements loss function i.e. recon and KL loss\n",
        "    recon_loss = nn.functional.binary_cross_entropy(recon, x, reduction='sum')\n",
        "    kl_loss    = -0.5 * torch.sum(1 + lv - mu.pow(2) - lv.exp())\n",
        "    return recon_loss + kl_loss\n",
        "    #return recon_loss"
      ]
